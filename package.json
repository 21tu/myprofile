{
  "name": "myprofile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lhci": "lhci autorun",
    "test:ci": "vitest run --reporter=default --reporter=github-actions",
    "dev": "next dev",
    "build": "next build",
    "build:staging": "node scripts/build-with-env.mjs staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "npm run check:content && wrangler deploy",
    "postbuild": "node scripts/generate-headers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:content": "vitest run tests/unit/content-check.test.ts",
    "preview": "wrangler dev --local",
    "prebuild": "node scripts/generate-vcard.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
