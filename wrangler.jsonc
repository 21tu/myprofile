{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myprofile",
  "workers_dev": false,
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
  "env": {
    "staging": {
      "name": "myprofile-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./out",
        "not_found_handling": "404-page",
      },
    },
  },
}
